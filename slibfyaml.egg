;; -*- scheme -*-
;;
;; slibfyaml.egg -- CHICKEN egg-information for slibfyaml.
;;
;; Through Phase 6 (multi-document streaming): (slibfyaml thin),
;; (slibfyaml), (slibfyaml nodes), (slibfyaml documents), and
;; (slibfyaml documents streams) exist -- see PLAN.md's "Phased
;; roadmap". Further extension components (slibfyaml.scheme) are added
;; as each is implemented, not declared speculatively ahead of the code
;; existing.
;;
;; No explicit intra-egg dependency declaration between components is
;; needed here, confirmed live by testing both ways: chicken-install
;; builds every component as its own dynamically-loaded extension
;; (.so), and a consuming program's `(import (slibfyaml documents))`
;; resolves slibfyaml.documents' own internal requirement on
;; slibfyaml.nodes/slibfyaml.thin/slibfyaml via the ordinary
;; repository-based dynamic-load mechanism at runtime -- unlike the
;; manual `csc -unit ... -uses ...`/static-.o inner-loop workflow in
;; AGENTS.md's Build section, which does need `-uses` spelled out
;; explicitly per compile, because static linking (not dynamic
;; loading) is how that path resolves a module's own internal
;; `(import ...)` forms. (A `component-dependencies` field was tried
;; here first, on the assumption it would be required the same way
;; `-uses` is manually -- rebuilding into a scratch prefix both with
;; and without it produced an identical, working result either way,
;; so it was removed rather than left in as unverified/probably-inert.)
;;
;; Link step: this machine's system libfyaml (`pkg-config --libs libfyaml`
;; reports plain "-lfyaml", no -L path needed -- confirmed directly) is
;; hard-coded as "-L" "-lfyaml" below rather than shelling out to
;; pkg-config via custom-config. See PLAN.md's "Build/packaging" section
;; for the custom-config alternative to investigate if a future machine
;; needs a non-standard libfyaml location.

((synopsis "Handle/tree binding to libfyaml (YAML 1.2 core-schema parser/emitter/document API), alibfyaml's Ada design ported to CHICKEN Scheme")
 (author "Thomas Kurt Bond")
 (category ffi)
 (license "BSD-2-Clause")
 (dependencies (chicken "5.4.0"))
 (foreign-dependencies "libfyaml -- https://github.com/pantoniou/libfyaml (developed against the system package reporting version 0.8 but exposing the 1.0-beta1 API; see PLAN.md's \"Target libfyaml version\" section)")

 (components
  (extension slibfyaml.thin
    (source "slibfyaml-thin.scm")
    (link-options "-L" "-lfyaml"))
  (extension slibfyaml
    (source "slibfyaml.scm"))
  (extension slibfyaml.nodes
    (source "slibfyaml-nodes.scm")
    (link-options "-L" "-lfyaml"))
  (extension slibfyaml.documents
    (source "slibfyaml-documents.scm")
    (link-options "-L" "-lfyaml"))
  (extension slibfyaml.documents.streams
    (source "slibfyaml-documents-streams.scm")
    (link-options "-L" "-lfyaml"))))
